<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Repository tooling (never packed, never shipped): verifies and inventories the
    CodeBrix.Platform Core assemblies that build/intake/CodeBrix.Android.Intake.proj
    extracts from the pinned Platform build. The intake project builds this tool and
    runs it after every extraction; see MAINTAINER-README.txt (INTAKE).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Android.IntakeGate</AssemblyName>
    <RootNamespace>CodeBrix.Android.IntakeGate</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.AssemblyTools.MitLicenseForever" />
  </ItemGroup>

</Project>
