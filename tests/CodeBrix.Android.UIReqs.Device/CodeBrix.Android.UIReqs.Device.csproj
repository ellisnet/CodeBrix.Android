<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CodeBrix.Android.UIReqs.Device: the scenario app of the UIReqs port (AP2). It hosts the
    CodeBrix.Platform UIReqs virtual application on Android and runs the COPIED scenario code
    (Scenarios/: steps, hooks, element factory, canvas vocabulary; from CodeBrix.Platform
    src/UIReqs/Platform.UI.Core, see PORTING.txt) step by step for the host runner
    (tests/CodeBrix.Android.UIReqs), which drives it over `adb forward` (Runtime/StepServer).
    Scenarios/Features/ holds the ONE copy of the feature files; the host project links them.
    Nullable is enabled: the copied scenario code is CodeBrix.Platform code (NRT on).
    Deploy with build/test-scripts/android-uireqs-run.sh (Debug, -t:Install).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.codebrix.uireqs</ApplicationId>
    <ApplicationTitle>CodeBrix UIReqs</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RootNamespace>CodeBrix.Android.UIReqs.Device</RootNamespace>
    <AssemblyName>CodeBrix.Android.UIReqs.Device</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- The copied Graphics3DGL fixtures hand the GL binding vertex-attribute offsets as raw pointers (as the
         Platform's own Graphics3DGL UIReqs project does). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The feature files are the host runner's input (linked there); they are not compiled here. -->
    <None Remove="Scenarios/Features/**" />
    <None Include="Scenarios/Features/**/*.feature" />
    <!-- Android-only groups (AndroidFeatures/<Group>/, steps in AndroidSteps/): real Android input and
         native behaviour that the copied, injector-driven scenarios cannot show. -->
    <None Remove="AndroidFeatures/**" />
    <None Include="AndroidFeatures/**/*.feature" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lottie group's two animation documents, verbatim (Scenarios/AddIns/Lottie/Assets), as app assets at the
         ms-appx:///Assets/ paths the copied fixtures name (AP1.12: ms-appx reads the APK's assets through
         IApplicationPackageFilesPlatform, so ANDROID PORT (f) - embedded:// resources - is undone). -->
    <Content Include="Scenarios/AddIns/Lottie/Assets/*.json" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same pulse document as an app asset at ms-appx:///Assets/LottieFence/pulse.json, for the AndroidNative fence of
         ms-appx Lottie sources. -->
    <Content Include="Scenarios/AddIns/Lottie/Assets/pulse.json" Link="Assets/LottieFence/pulse.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The AudioPlayer group's silent fixtures, verbatim (Scenarios/AddIns/AudioPlayer/Assets): opened BY PATH (an .sfz names its
         samples beside it), so they are EmbeddedResources written to a cache folder on first use (ANDROID PORT (b), AP7-C). -->
    <EmbeddedResource Include="Scenarios/AddIns/AudioPlayer/Assets/**/*" LogicalName="AudioPlayerAssets/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The same fixtures as app assets at ms-appx:///Assets/AudioFence/ (silence2s.wav, silent.sfz + Samples/silence.wav), for the
         AndroidAudioPlayer fences of ms-appx audio (the asset copy folder, an SFZ with its samples). -->
    <Content Include="Scenarios/AddIns/AudioPlayer/Assets/silence2s.wav;Scenarios/AddIns/AudioPlayer/Assets/silent.sfz" Link="Assets/AudioFence/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scenarios/AddIns/AudioPlayer/Assets/Samples/silence.wav" Link="Assets/AudioFence/Samples/silence.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- The VideoPlayer group's three clips, verbatim (Scenarios/AddIns/VideoPlayer/Assets): opened BY PATH, so they are
         EmbeddedResources written to a cache folder on first use (ANDROID PORT (b), AP7-C). The two-colour clip is also an app
         asset at ms-appx:///Assets/VideoFence/, for the AndroidVideoPlayer fence of ms-appx video. -->
    <EmbeddedResource Include="Scenarios/AddIns/VideoPlayer/Assets/*.mkv" LogicalName="VideoPlayerAssets/%(Filename)%(Extension)" />
    <Content Include="Scenarios/AddIns/VideoPlayer/Assets/twocolour_raw_videoonly.mkv" Link="Assets/VideoFence/twocolour_raw_videoonly.mkv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" />
  </ItemGroup>

</Project>
