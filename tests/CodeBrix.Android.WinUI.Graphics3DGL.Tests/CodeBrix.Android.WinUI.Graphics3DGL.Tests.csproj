<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-free tests (net10.0) of the CodeBrix.Android Graphics3DGL add-in: its portable parts (the read-back pixel
    arithmetic and the EGL attribute lists, compiled in from source, Linked/) and the Core contract it implements, read
    from the pinned Core assembly's metadata (the twin-loading name, the grants, the GL calls it makes). The EGL
    context, the handlers and the pictures are exercised on the emulator (the Graphics3DGL UIReqs group).

    AssemblyName = the name CodeBrix.Platform.WinUI.Graphics3DGL.Core grants InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CodeBrix.Android.WinUI.Graphics3DGL.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Android.WinUI.Graphics3DGL.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)build/intake/CodeBrix.Android.Intake.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The portable parts of the add-in, compiled into this test assembly. -->
  <ItemGroup>
    <Compile Include="..\..\src\AddIns\CodeBrix.Android.WinUI.Graphics3DGL\Portable\*.cs" Link="Linked\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoreMetadata.cs" Link="Shared\CoreMetadata.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as metadata only (PEReader), never loaded. -->
    <AssemblyMetadata Include="CodeBrix.Android.Tests.CoreLib" Value="$(CodeBrixPlatformIntakeLibDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
  </ItemGroup>

</Project>
