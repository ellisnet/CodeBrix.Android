<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Surface library for the PainDiagram paste-always head: PainDiagram.Core (CodeBrix.Samples
    PainDiagram/CodeBrixPlatform/PainDiagram.Core, which links its sources from PainDiagram/Shared), built as its own
    assembly with the source project's own settings: root namespace PainDiagram, the HAS_CODEBRIX /
    HAS_CODEBRIX_WINUI / HAS_CODEBRIXPLATFORM defines the shared DrawingCanvas and view model select their
    CodeBrix.Platform branch with, and the embedded body-map image under the logical name the view model loads.
    Verbatim copies: see ../SOURCES.txt.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>PainDiagram</RootNamespace>
    <AssemblyName>PainDiagram.Core</AssemblyName>
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI;HAS_CODEBRIXPLATFORM</DefineConstants>
    <CodeBrixAndroidInRepoAddIns>SkiaSharpViews</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\body_map_master.png">
      <LogicalName>PainDiagram.Assets.body_map_master.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CodeBrix.Imaging.Drawing.ApacheLicenseForever" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
