<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Paste-always compile head: PainDiagram (CodeBrix.Samples PainDiagram/CodeBrixPlatform/PainDiagram.UI).
    Pasted/ = the shared UI project's files, verbatim (App, MainPage and the two Services files the .projitems
    lists). Surface/PainDiagram.Core = the app's Core as its own Surface project (verbatim copies of the Shared/
    sources it links, with the source project's defines). SKXamlCanvas is the real SkiaSharp.Views add-in.
    See Surface/SOURCES.txt.
  -->
  <PropertyGroup>
    <ApplicationId>com.codebrix.pastealways.paindiagram</ApplicationId>
    <!-- The desktop heads keep the default root namespace (= assembly name); the generator names its per-assembly types after it. -->
    <RootNamespace>PainDiagram.PasteAlways</RootNamespace>
    <AssemblyName>PainDiagram.PasteAlways</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>SkiaSharpViews</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Pasted\App.xaml" />
    <Page Include="Pasted\Views\MainPage.xaml" />
  </ItemGroup>

  <!-- PainDiagram.Core is its own assembly, not the head's. -->
  <ItemGroup>
    <Compile Remove="Surface\PainDiagram.Core\**" />
    <None Remove="Surface\PainDiagram.Core\**" />
    <EmbeddedResource Remove="Surface\PainDiagram.Core\**" />
    <AndroidLibrary Remove="Surface\**" />
    <AndroidJavaSource Remove="Surface\**" />
    <ProjectReference Include="Surface\PainDiagram.Core\PainDiagram.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" />
  </ItemGroup>

</Project>
