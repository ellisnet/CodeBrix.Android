<Project>

  <!--
    tests/PasteAlways: the paste-always compile test (plan 4.10, AP1.7).

    One throw-away Android head per corpus page (<App>/<App>.PasteAlways.csproj). Each head
    compiles the page's App.xaml, App.xaml.cs, MainPage.xaml and MainPage.xaml.cs (plus the
    MainPage partial-class files and the page's own XAML controls) - VERBATIM copies of
    CodeBrix.Samples files, kept under <App>/Pasted/ and fingerprinted in
    <App>/pasted-files.sha256 - for net10.0-android36.1 against the CodeBrix.Android build.
    What the pasted files reference but the Android build does not provide (the app's .Core
    types, desktop-only services, add-ins without an Android flavor yet) comes from
    <App>/Surface/: verbatim copies where they compile, otherwise stubs with the same public
    surface. The pasted files are never edited.

    The heads are not part of CodeBrix.Android.slnx (eight Android application builds);
    build/test-scripts/paste-always-compile.sh builds them and reports per page.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <CodeBrixAndroidInRepoConsumer>true</CodeBrixAndroidInRepoConsumer>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!--
      [AP1.16, coordinator ruling 2026-10-07] The CodeBrix.Platform XAML generator's own WARNINGS (Uno-prefixed ids;
      today Uno0008 "binding target property not found", new in Platform 1.0.280.1176, severity Warning) stay warnings
      here although the repository treats warnings as errors: the Platform raises them identically on every head, so a
      pasted page that triggers one still "compiles on Android" (the paste-always contract). The paste-always script
      COUNTS them (UNO column, uno-counts.tsv, uno-findings.txt), as it counts CBAND - never a failure. The generator's
      Error-severity ids are not listed: they stay errors.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);Uno0008</WarningsNotAsErrors>
  </PropertyGroup>

  <Import Project="$(CodeBrixAndroidRepoRoot)build/inrepo/CodeBrix.Android.InRepo.props" />

</Project>
