<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Paste-always compile head: NotionDocumentCreator (CodeBrix.Samples
    NotionDocumentCreator/src/NotionDocumentCreator.UI). Pasted/ = the shared UI project's files,
    verbatim. Surface/ = the page's view models and helpers (NotionDocumentCreator.Core) and the
    public types of the CreateDocument library it uses - verbatim copies, except the document
    service itself, a stub (see Surface/SOURCES.txt). The FlexPanel add-in Core comes from the intake.
  -->
  <PropertyGroup>
    <ApplicationId>com.codebrix.pastealways.notiondocumentcreator</ApplicationId>
    <!-- The desktop heads keep the default root namespace (= assembly name); the generator names its per-assembly types after it. -->
    <RootNamespace>NotionDocumentCreator.PasteAlways</RootNamespace>
    <AssemblyName>NotionDocumentCreator.PasteAlways</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>FlexPanel</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Pasted\App.xaml" />
    <Page Include="Pasted\Views\MainPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
