<Application
    x:Class="InannaRosette.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================ PALETTE ============================ -->
            <Color x:Key="NightColor">#0F0A1E</Color>
            <Color x:Key="Night2Color">#1A1030</Color>
            <Color x:Key="KohlColor">#07050D</Color>
            <Color x:Key="LapisColor">#1F3A93</Color>
            <Color x:Key="LapisLightColor">#2B4CB8</Color>
            <Color x:Key="LapisGlowColor">#4C6FE0</Color>
            <Color x:Key="GoldColor">#E6C476</Color>
            <Color x:Key="GoldDeepColor">#C9A14A</Color>
            <Color x:Key="GoldPaleColor">#F3DFA2</Color>
            <Color x:Key="GoldShadowColor">#8A6A1F</Color>
            <Color x:Key="CarnelianColor">#B6402E</Color>
            <Color x:Key="CarnelianLightColor">#D9634E</Color>
            <Color x:Key="IvoryColor">#F4EBD9</Color>
            <Color x:Key="ParchmentColor">#EFE3C8</Color>
            <Color x:Key="InkColor">#2A1E12</Color>
            <Color x:Key="MalachiteColor">#2E8B6B</Color>

            <SolidColorBrush x:Key="NightBrush" Color="#0F0A1E" />
            <SolidColorBrush x:Key="Night2Brush" Color="#1A1030" />
            <SolidColorBrush x:Key="KohlBrush" Color="#07050D" />
            <SolidColorBrush x:Key="LapisBrush" Color="#1F3A93" />
            <SolidColorBrush x:Key="LapisLightBrush" Color="#2B4CB8" />
            <SolidColorBrush x:Key="LapisGlowBrush" Color="#4C6FE0" />
            <SolidColorBrush x:Key="GoldBrush" Color="#E6C476" />
            <SolidColorBrush x:Key="GoldDeepBrush" Color="#C9A14A" />
            <SolidColorBrush x:Key="GoldPaleBrush" Color="#F3DFA2" />
            <SolidColorBrush x:Key="GoldShadowBrush" Color="#8A6A1F" />
            <SolidColorBrush x:Key="CarnelianBrush" Color="#B6402E" />
            <SolidColorBrush x:Key="CarnelianLightBrush" Color="#D9634E" />
            <SolidColorBrush x:Key="IvoryBrush" Color="#F4EBD9" />
            <SolidColorBrush x:Key="ParchmentBrush" Color="#EFE3C8" />
            <SolidColorBrush x:Key="InkBrush" Color="#2A1E12" />
            <SolidColorBrush x:Key="MalachiteBrush" Color="#2E8B6B" />

            <!-- derived / translucent -->
            <SolidColorBrush x:Key="BodyTextBrush" Color="#EBF4EBD9" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#99F4EBD9" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#66F4EBD9" />
            <SolidColorBrush x:Key="GoldHairlineBrush" Color="#70C9A14A" />
            <SolidColorBrush x:Key="GoldFaintBrush" Color="#40C9A14A" />
            <SolidColorBrush x:Key="GoldGhostBrush" Color="#22E6C476" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1030" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#221640" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#120C24" />
            <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />

            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#1A1030" Offset="0" />
                <GradientStop Color="#0F0A1E" Offset="0.55" />
                <GradientStop Color="#07050D" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#231646" Offset="0" />
                <GradientStop Color="#140D28" Offset="1" />
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="AltarGlowBrush" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                <GradientStop Color="#3A2A6A" Offset="0" />
                <GradientStop Color="#00120A24" Offset="1" />
            </RadialGradientBrush>

            <!-- ============================ FONTS ============================ -->
            <FontFamily x:Key="MerriweatherFont">ms-appx:///CodeBrix.Platform.Fonts.Merriweather/Fonts/Merriweather.ttf</FontFamily>
            <FontFamily x:Key="MerriweatherBoldFont">ms-appx:///CodeBrix.Platform.Fonts.Merriweather/Fonts/Merriweather-Bold.ttf</FontFamily>

            <!-- ============================ TEXT STYLES ============================ -->
            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherBoldFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="21" />
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherBoldFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherBoldFont}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource GoldPaleBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="TrackedCapsStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{StaticResource GoldDeepBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- ============================ BUTTONS ============================ -->
            <Style x:Key="TempleButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldDeepBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7,14,8" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid">
                                <Border x:Name="Fill"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" />
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#E6C476" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#0F0A1E" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#C9A14A" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#07050D" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TemplePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TempleButtonStyle}">
                <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                <Setter Property="Foreground" Value="#0F0A1E" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldPaleBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid">
                                <Border x:Name="Fill"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" />
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#F3DFA2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#C9A14A" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource TempleButtonStyle}">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Padding" Value="8,4,8,5" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <!-- ============================ TEXT INPUT ============================ -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#120C24" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#181030" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1C1236" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#120C24" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#70C9A14A" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C9A14A" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E6C476" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#40C9A14A" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#F4EBD9" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F4EBD9" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4EBD9" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#99F4EBD9" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80F4EBD9" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80F4EBD9" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80F4EBD9" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#4C6FE0" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#99F4EBD9" />
            <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />

            <Style x:Key="TempleTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource MerriweatherFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="9,5,9,6" />
                <Setter Property="PlaceholderForeground" Value="#80F4EBD9" />
                <Setter Property="SelectionHighlightColor" Value="#4C6FE0" />
            </Style>

            <!-- ============================ SCROLLVIEWER ============================ -->
            <Style x:Key="PanelScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalScrollMode" Value="Enabled" />
                <Setter Property="ZoomMode" Value="Disabled" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>

            <!-- ============================ DIALOGS ============================ -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#1A1030" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#F4EBD9" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#C9A14A" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1030" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#40C9A14A" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#B0000000" />
            <SolidColorBrush x:Key="ContentDialogLightDismissOverlayBackground" Color="#B0000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
