<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Surface library for the PolyHavenBrowser paste-always head: PolyHavenBrowser.Rendering (CodeBrix.Samples
    PolyHavenBrowser/src/libs/PolyHavenBrowser.Rendering), built as its own assembly with the source library's
    own settings (nullable, implicit usings, unsafe code, its own root namespace), because the verbatim copies
    only compile under those settings and the page names the assembly (xmlns render ...;assembly=
    PolyHavenBrowser.Rendering). ModelSceneGlCanvas derives from the real Graphics3DGL GLCanvasElement (the
    add-in's Core); the renderer draws with the OpenGL binding the Core renders through. See ../SOURCES.txt.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PolyHavenBrowser.Rendering</RootNamespace>
    <AssemblyName>PolyHavenBrowser.Rendering</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>Graphics3DGL</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" />
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" />
    <PackageReference Include="CodeBrix.Platform.OpenGL.MitLicenseForever" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
