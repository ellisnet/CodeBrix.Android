<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Surface library for the PolyHavenBrowser_viewer_only paste-always head: PolyHavenBrowser.Rendering
    (CodeBrix.Samples PolyHavenBrowser_viewer_only/src/libs/PolyHavenBrowser.Rendering), built as its own assembly
    with the source library's own settings (nullable, implicit usings, unsafe code, its own root namespace).
    Verbatim copies except the Vulkan renderer and the OpenEXR decoder (stubs: their third-party packages,
    Silk.NET.Vulkan and TinyEXR.NET, are not allowed here). The OpenGL binding comes in as the Graphics3DGL add-in's
    Core renders through it (the source library takes it transitively from the Graphics3DGL package). See ../SOURCES.txt.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PolyHavenBrowser.Rendering</RootNamespace>
    <AssemblyName>PolyHavenBrowser.Rendering</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>Graphics3DGL</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" />
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" />
    <PackageReference Include="CodeBrix.Platform.OpenGL.MitLicenseForever" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
