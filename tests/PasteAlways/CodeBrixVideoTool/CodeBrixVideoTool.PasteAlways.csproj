<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Paste-always compile head: CodeBrixVideoTool (CodeBrix.Samples CodeBrixVideoTool/src/CodeBrixVideoTool.UI).
    Pasted/ = the shared UI project's files, verbatim. Surface/ = the app's CodeBrixVideoTool.Core and its
    Playback / Processing libraries (verbatim; same language settings as the head). The VideoPlayer element is the
    real Android add-in (AP7-C). The app is NotSupported on Android at run time (it needs CodeBrix.VideoPlayback.Authoring,
    which is not supported on Android - D-O14, Jeremy 2026-09-27); this head only proves the page compiles. See
    Surface/SOURCES.txt.
  -->
  <PropertyGroup>
    <ApplicationId>com.codebrix.pastealways.codebrixvideotool</ApplicationId>
    <!-- The desktop heads keep the default root namespace (= assembly name); the generator names its per-assembly types after it. -->
    <RootNamespace>CodeBrixVideoTool.PasteAlways</RootNamespace>
    <AssemblyName>CodeBrixVideoTool.PasteAlways</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>VideoPlayer</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Pasted\App.xaml" />
    <Page Include="Pasted\Views\MainPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" />
    <PackageReference Include="CodeBrix.VideoPlayback.Authoring.MitLicenseForever" />
    <!--
      This head only compiles (it never runs): the packages' native assets are excluded. They ship
      linux-x64 natives that an android-x64 build would pick up through the RID fallback (XA0141).
    -->
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" ExcludeAssets="native" />
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" ExcludeAssets="native" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" />
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" />
  </ItemGroup>

</Project>
