<Project>

  <!--
    Paste-always head SimpleCbxVideoPlayer: the repository pins, plus the self-produced CodeBrix.*
    packages (not CodeBrix.Platform repo packages) the app's verbatim Core / SkiaVideo sources
    (Surface/) use, at the versions CodeBrix.Samples SimpleCbxVideoPlayer pins.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <ItemGroup>
    <!-- AP7-C: CodeBrix.VideoPlayback is pinned by the repository (1.0.271.97, the VideoPlayer add-in's); the packages below
         moved with it to their versions on the same CodeBrix.Audio.Core 1.0.269.1270 line (the sample pins the 1.0.256 line). -->
    <PackageVersion Include="CodeBrix.VideoPlayback.Skia.MitLicenseForever" Version="1.0.280.1149" />
    <PackageVersion Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.271.1206" />
    <PackageVersion Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.271.1185" />
    <!-- Referenced directly only to exclude its native assets (the desktop backend facade CodeBrix.VideoPlayback.Skia depends on). -->
    <PackageVersion Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.271.1165" />
  </ItemGroup>

</Project>
