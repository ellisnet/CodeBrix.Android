<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Paste-always compile head: Pinta.Brix (CodeBrix.Samples Pinta.Brix/src/Pinta.Brix.UI).
    Pasted/ = the shared UI project's files, verbatim (App, MainPage and its partial-class files,
    Dialogs/). The app's Pinta.Brix.Core and libs are compiled from verbatim sources as their own
    assemblies under Surface/ (their language settings differ from the head's); the add-ins without
    an Android flavor (SkiaSharp.Views SKXamlCanvas, TextLayout) come from Surface/Stubs. See
    Surface/SOURCES.txt.
  -->
  <PropertyGroup>
    <ApplicationId>com.codebrix.pastealways.pintabrix</ApplicationId>
    <!-- The desktop heads keep the default root namespace (= assembly name); the generator names its per-assembly types after it. -->
    <RootNamespace>Pinta.Brix.PasteAlways</RootNamespace>
    <AssemblyName>Pinta.Brix.PasteAlways</AssemblyName>
    <CodeBrixAndroidInRepoAddIns>AppSettings</CodeBrixAndroidInRepoAddIns>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Pasted\App.xaml" />
    <Page Include="Pasted\Views\MainPage.xaml" />
  </ItemGroup>

  <!-- Surface/ holds separate projects; the head compiles only Pasted/. -->
  <ItemGroup>
    <Compile Remove="Surface\**" />
    <None Remove="Surface\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Surface\Pinta.Brix.Core\Pinta.Brix.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
