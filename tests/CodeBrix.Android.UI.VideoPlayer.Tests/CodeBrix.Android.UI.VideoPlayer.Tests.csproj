<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-free tests (net10.0) of the Android side of the VideoPlayer add-in (AP7-C):
    - Core/: the contract the Android assembly implements and relies on, read from the pinned VideoPlayer Core (the grants
      to the Android assembly name, the by-name load, IAssetLocation, what the Core does NOT carry - the VideoPlayer element
      and its public companions, which the Android add-in re-provides -, the rules and the source resolver the port reuses),
      and the Core's source resolver over an IAssetLocation whose root is the Android asset-copy folder;
    - Portable/: the ms-appx path rule of the Android add-in (Portable/PackagedAssetPaths, linked).
    Decode, the picture, the sound and the render paths run on the emulator (the VideoPlayer UIReqs group, the
    AndroidVideoPlayer fences) and on the two real devices (the sample gate).

    AssemblyName = the name CodeBrix.Platform.UI.VideoPlayer.Core grants InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CodeBrix.Android.UI.VideoPlayer.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Android.UI.VideoPlayer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Android.UI\CodeBrix.Android.UI.csproj" />
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)build/intake/CodeBrix.Android.Intake.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoreMetadata.cs" Link="Shared\CoreMetadata.cs" />
    <Compile Include="$(CodeBrixAndroidRepoRoot)src/AddIns/CodeBrix.Android.UI.VideoPlayer/Portable/*.cs" Link="Linked\Portable\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CodeBrix.Android.Tests.CoreLib" Value="$(CodeBrixPlatformIntakeLibDir)" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.UI.VideoPlayer.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.UI.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.Foundation.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
  </ItemGroup>

</Project>
