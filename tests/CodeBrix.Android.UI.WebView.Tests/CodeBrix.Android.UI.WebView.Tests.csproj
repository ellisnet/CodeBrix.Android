<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-free tests (net10.0) of the CodeBrix.Android WebView add-in: its portable parts
    (compiled in from source, Linked/) and the Core contract it implements, read from the pinned
    Core assembly's metadata (the twin-loading names and grants), plus the fence between the
    Android document-start script and the framework's shared host-to-page scripts (the pinned
    CodeBrix.Platform.UI.Core is referenced for that one internal type; the grant to this assembly
    name is the framework's). The Android views, handlers and the pages are exercised on the
    emulator (the WebView UIReqs group).

    AssemblyName = the name CodeBrix.Platform.UI.Core grants InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CodeBrix.Android.UI.WebView.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Android.UI.WebView.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)build/intake/CodeBrix.Android.Intake.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The portable parts of the add-in, compiled into this test assembly. -->
  <ItemGroup>
    <Compile Include="..\..\src\AddIns\CodeBrix.Android.UI.WebView\Portable\*.cs" Link="Linked\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoreMetadata.cs" Link="Shared\CoreMetadata.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as metadata only (PEReader) by the Core contract tests. -->
    <AssemblyMetadata Include="CodeBrix.Android.Tests.CoreLib" Value="$(CodeBrixPlatformIntakeLibDir)" />
    <!-- The framework's shared WebViewScripts (host-to-page delivery), for the script-parity fence; its Core
         dependencies ride along so the assembly loads host-free. -->
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.UI.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.UI.Composition.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.UI.Dispatching.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.Foundation.Core.dll" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
  </ItemGroup>

</Project>
