<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-free tests (net10.0) of the CodeBrix.Android FlexPanel add-in: the Core it re-ships whole,
    read from the pinned Core assembly's metadata (the grants the Android assembly name relies on).
    The layout itself is exercised on the emulator (the FlexPanel UIReqs group).

    AssemblyName = the name CodeBrix.Platform.UI.FlexPanel.Core grants InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CodeBrix.Android.UI.FlexPanel.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Android.UI.FlexPanel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)build/intake/CodeBrix.Android.Intake.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoreMetadata.cs" Link="Shared\CoreMetadata.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as metadata only (PEReader), never loaded. -->
    <AssemblyMetadata Include="CodeBrix.Android.Tests.CoreLib" Value="$(CodeBrixPlatformIntakeLibDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
  </ItemGroup>

</Project>
