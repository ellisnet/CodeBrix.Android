<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-free tests (net10.0) of the CodeBrix.Android CommandBar add-in: the Core contract it implements,
    read from the pinned Core assembly's metadata (the grants the Android assembly name relies on), and the add-in's
    portable rules (Portable/, compiled in from source: the overflow flyout's item-click rule).
    The bars and icons are exercised on the emulator (the CommandBar UIReqs group).

    AssemblyName = the name CodeBrix.Platform.UI.CommandBar.Core grants InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CodeBrix.Android.UI.CommandBar.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Android.UI.CommandBar.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)build/intake/CodeBrix.Android.Intake.proj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CoreMetadata.cs" Link="Shared\CoreMetadata.cs" />
    <!-- The add-in's portable rules (pure C#), compiled into this test assembly. -->
    <Compile Include="..\..\src\AddIns\CodeBrix.Android.UI.CommandBar\Portable\*.cs" Link="Linked\Portable\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as metadata only (PEReader), never loaded. -->
    <AssemblyMetadata Include="CodeBrix.Android.Tests.CoreLib" Value="$(CodeBrixPlatformIntakeLibDir)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" />
  </ItemGroup>

</Project>
