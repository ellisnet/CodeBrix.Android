<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="24dp">
    <TextView
        android:id="@+id/counter_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="48sp"
        android:text="0" />
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:textSize="16sp"
        android:text="@string/status_ready" />
    <Button
        android:id="@+id/count_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_count" />
    <Button
        android:id="@+id/compute_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_compute" />
    <Button
        android:id="@+id/async_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_async" />
    <Button
        android:id="@+id/background_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_background" />
    <Button
        android:id="@+id/throw_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_throw" />
</LinearLayout>
