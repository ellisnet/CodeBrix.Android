<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VERBATIM copy of CodeBrix.Samples JustBetweenUs/JustBetweenUs.Encryption (a UI-free
    net10.0 library; an Android app consumes it unchanged). Only the package versions
    moved to the repository's Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeBrixAndroidInRepoConsumer>false</CodeBrixAndroidInRepoConsumer>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Embedded\DefaultKey.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Embedded\DefaultKey.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Cryptography.MitLicenseForever" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
