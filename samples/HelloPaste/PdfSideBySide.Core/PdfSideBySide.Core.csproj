<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PdfSideBySide.Core in the D-O2 app shape (net10.0 for the desktop heads,
    net10.0-android36.1 for Android). The sources are VERBATIM copies of CodeBrix.Samples
    PdfSideBySide/src/PdfSideBySide.Core; see ../README.md.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>PdfSideBySide</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfSideBySide.PdfRender\PdfSideBySide.PdfRender.csproj" />
  </ItemGroup>

</Project>
