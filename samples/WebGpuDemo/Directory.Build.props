<Project>

  <!--
    samples/WebGpuDemo: the WebGpu add-in's sample app. The repository-wide settings apply, then the in-repository
    CodeBrix.Android consumer wiring (the package layout simulated from the intake; see
    build/inrepo/CodeBrix.Android.InRepo.props).

    The pages and renderers are copies of the CodeBrix.Platform WebGpuDemo sample (see README.md for the source of every
    file; sample-app duplicates are intentional); they are compiled with the family settings, but they are not
    CodeBrix.Android library code: no XML-doc requirement and no packing.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <CodeBrixAndroidInRepoConsumer>true</CodeBrixAndroidInRepoConsumer>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Import Project="$(CodeBrixAndroidRepoRoot)build/inrepo/CodeBrix.Android.InRepo.props" />

</Project>
