<UserControl x:Class="WebGpuDemo.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webGpu="using:CodeBrix.Platform.UI.WebGpu">
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Android sample: the caption and the status line wrap on a phone held upright (the status line sits above the
         camera slider instead of beside it). -->
    <TextBlock Text="Models: CodeBrix.WebGpu.Graphics drawing glTF models straight into the view" FontSize="20" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock x:Name="Status" Text="Waiting for a device" TextWrapping="Wrap" AutomationProperties.AutomationId="ModelsStatus" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Turn the camera" VerticalAlignment="Center" />
        <Slider x:Name="CameraSlider" Width="240" Minimum="-180" Maximum="180" Value="0" StepFrequency="1"
                ValueChanged="OnCameraChanged" AutomationProperties.Name="Turn the camera" />
      </StackPanel>
    </StackPanel>

    <!-- GraphicsContext.Wrap(the view's device) in DeviceReady, GraphicsContext.BeginFrame(the view) in Render: the
         view is an IWebGpuDeviceSource and an IWebGpuTextureTarget, so the higher layer renders into it with neither
         package knowing about the other. -->
    <Grid Grid.Row="2">
      <webGpu:WebGpuRenderView x:Name="View"
                               AutomationProperties.AutomationId="ModelsViewport"
                               DeviceReady="OnDeviceReady"
                               Render="OnRender"
                               DeviceLost="OnDeviceLost" />
      <TextBlock x:Name="Placeholder" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="600"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 AutomationProperties.AutomationId="ModelsPlaceholder" />
    </Grid>

    <TextBlock Grid.Row="3" FontSize="12" TextWrapping="Wrap"
               Text="Models: Cube Pets and Survival Kit by Kenney (www.kenney.nl), and the Avian from Crystals and Avian by Jeremy Ellis - all CC0." />
  </Grid>
</UserControl>
