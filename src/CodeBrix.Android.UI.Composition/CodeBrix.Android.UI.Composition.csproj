<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android composition platform: an INERT implementation of the
    CodeBrix.Platform.UI.Composition Core contracts (Core keeps building its managed
    Visual tree, nothing paints it; native views do) plus the android.graphics.Path
    backed composition geometry. AssemblyName = the name
    CodeBrix.Platform.UI.Composition.Core grants InternalsVisibleTo to.

    Two target frameworks: net10.0-android36.1 (everything) and net10.0 (the pure-managed
    parts only - the inert platform, Portable/ and HostFree/ - so host-free tests can give
    Core a composition platform; nothing ships the net10.0 flavor in an app).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>
    <AssemblyName>CodeBrix.Android.UI.Composition</AssemblyName>
    <RootNamespace>CodeBrix.Android.UI.Composition</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- net10.0: the pure-managed inert platform and the host-free registration only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Android/**" />
    <Compile Include="Android/InertCompositionPlatforms.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <Compile Remove="HostFree/**" />
  </ItemGroup>

</Project>
