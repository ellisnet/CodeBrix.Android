<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CodeBrix.Android.WinUI.Graphics3DGL: the Android side of the CodeBrix.Platform Graphics3DGL add-in (AP7.11).
    Its Core (CodeBrix.Platform.WinUI.Graphics3DGL.Core, re-shipped by the intake) holds GLCanvasElement: it asks the
    head for an off-screen OpenGL context (INativeOpenGLWrapper), renders its subclass into a framebuffer object and
    reads the picture back into a WriteableBitmap. This assembly supplies, for Android:
      * the off-screen context: EGL (libEGL) with an OpenGL ES 3 context on a 1x1 pbuffer, its GL entry points from
        libGLESv3 / eglGetProcAddress (Native/, Android/AndroidEglOpenGLWrapper.cs);
      * IGLCanvasPlatform (the element's visual) and the handler that SHOWS the read-back picture natively
        (a view group that draws it under the element's XAML children);
      * the public types the Platform's own flavor adds to the Core (OffscreenGLContext, SkiaGLCanvasElement,
        SkiaGLPaintSurfaceEventArgs, SkiaGpuContext; Public/), so application code written against the add-in
        compiles and runs unchanged.
    AssemblyName = the name CodeBrix.Platform.WinUI.Graphics3DGL.Core, UI.Core and UI.Composition.Core grant
    InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
    <AssemblyName>CodeBrix.Android.WinUI.Graphics3DGL</AssemblyName>
    <RootNamespace>CodeBrix.Android.WinUI.Graphics3DGL</RootNamespace>
    <!-- The read-back shim hands glReadPixels an unmanaged function pointer and converts pixels in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)src/CodeBrix.Android.UI/CodeBrix.Android.UI.csproj" />
    <!-- The add-in Core (re-shipped from the pinned Platform build by the intake). -->
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.WinUI.Graphics3DGL.Core.dll" />
    <!-- The managed OpenGL binding the Core renders with (self-produced, from a repository other than CodeBrix.Platform). -->
    <PackageReference Include="CodeBrix.Platform.OpenGL.MitLicenseForever" />
    <!-- SkiaGLCanvasElement / SkiaGpuContext: Skia on the GL context (Microsoft; the family's locked SkiaSharp release). -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
  </ItemGroup>

</Project>
