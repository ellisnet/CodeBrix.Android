<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CodeBrix.Android.WinUI.Graphics2DSK: the Android side of the CodeBrix.Platform Graphics2DSK add-in (AP7.16).
    Its Core (CodeBrix.Platform.WinUI.Graphics2DSK.Core, re-shipped by the intake) is the WHOLE add-in: the public
    SKCanvasElement paints through the Skia canvas-host factory (SKCanvasVisualBaseFactory) of the framework. On
    Android that factory is the SkiaSharp.Views add-in's, so this assembly only makes sure the canvas add-in is
    registered and shows SKCanvasElement with its canvas-element handler.
    AssemblyName = the name CodeBrix.Platform.WinUI.Graphics2DSK.Core (and UI.Core) grant InternalsVisibleTo to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>$(CodeBrixAndroidMinimumApiLevel)</SupportedOSPlatformVersion>
    <AssemblyName>CodeBrix.Android.WinUI.Graphics2DSK</AssemblyName>
    <RootNamespace>CodeBrix.Android.WinUI.Graphics2DSK</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)src/CodeBrix.Android.UI/CodeBrix.Android.UI.csproj" />
    <ProjectReference Include="$(CodeBrixAndroidRepoRoot)src/AddIns/CodeBrix.Android.SkiaSharp.Views/CodeBrix.Android.SkiaSharp.Views.csproj" />
    <Reference Include="$(CodeBrixPlatformIntakeLibDir)CodeBrix.Platform.WinUI.Graphics2DSK.Core.dll" />
  </ItemGroup>

</Project>
